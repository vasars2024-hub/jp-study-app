diff --git a/internal/directstream/localfile.go b/internal/directstream/localfile.go
index 76f4dcd..f34b31b 100644
--- a/internal/directstream/localfile.go
+++ b/internal/directstream/localfile.go
@@ -289,10 +289,19 @@ type PlayLocalFileOptions struct {
 	ClientId   string
 	Path       string
 	LocalFiles []*anime.LocalFile
+	// Generation is the client's own monotonically increasing id for this open request.
+	// Zero means unspecified. See [Manager.AcceptOpenGeneration].
+	Generation int64
 }
 
 // PlayLocalFile is used by a module to load a new torrent stream.
 func (m *Manager) PlayLocalFile(ctx context.Context, opts PlayLocalFileOptions) (err error) {
+	// Before BeginOpen, never after: BeginOpen replaces the current stream and stops its
+	// subtitle streams, so a request that has been overtaken must be refused while that is
+	// still undone.
+	if !m.AcceptOpenGeneration(opts.ClientId, opts.Generation) {
+		return fmt.Errorf("stale open request: generation %d is older than one already accepted for this client", opts.Generation)
+	}
 	if !m.BeginOpen(opts.ClientId, "Loading stream...", nil) {
 		return fmt.Errorf("stream opening was cancelled")
 	}
