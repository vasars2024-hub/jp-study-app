+func flushTerminalSubtitleBatch(err error, flush func(), stop func(bool)) {
+	// Stop cancels the stream context, and sendSubtitleEvents rejects a cancelled
+	// context. The terminal batch must therefore be sent before a successful stop.
+	flush()
+	if err == nil {
+		stop(true)
+	}
+}
