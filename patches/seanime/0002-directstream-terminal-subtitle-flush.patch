+func TestFlushTerminalSubtitleBatchFlushesBeforeSuccessfulStop(t *testing.T) {
+	var order []string
+
+	flushTerminalSubtitleBatch(nil, func() {
+		order = append(order, "flush")
+	}, func(completed bool) {
+		require.True(t, completed)
+		order = append(order, "stop")
+	})
+
+	require.Equal(t, []string{"flush", "stop"}, order)
+}
